{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "experimentalDecorators": true,
    "strict": false,
    "strictNullChecks": true,
    "noEmit": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "plugins": [{ "name": "./plugin" }]
  },
  "include": ["src/**/*.ts", "types/**/*.d.ts"]
}
